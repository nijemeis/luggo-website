# ── Database ──────────────────────────────────────────────────────────
# Local: Homebrew Postgres, database `luggo` (createdb luggo).
# Production: the pooled URL of a `luggo` database on the existing managed cluster.
# All tables are prefixed luggo_ so they can't collide with other apps.
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/luggo?schema=luggo"
DIRECT_DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/luggo?schema=luggo"  # the non-pooled URL in production

# ── Admin ─────────────────────────────────────────────────────────────
ADMIN_PASSWORD="luggo-admin"
# Random secret used to sign the admin session cookie (openssl rand -hex 32).
AUTH_SECRET="change-me-to-a-long-random-string-before-launch"

# ── Public site ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3020"

# ── Payments (Stripe) ─────────────────────────────────────────────────
# Leave empty to use the built-in mock checkout (dev only).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Email (Resend) ────────────────────────────────────────────────────
# Leave empty to log emails to the console instead of sending.
RESEND_API_KEY=""
EMAIL_FROM="Luggo <orders@luggo.net>"
SHOP_NOTIFY_EMAIL=""

# ── File storage ──────────────────────────────────────────────────────
# Default: local disk under ./storage (dev only — production refuses to write without a bucket).
# DigitalOcean Spaces: region tor1 (same as the database), endpoint https://tor1.digitaloceanspaces.com.
STORAGE_DIR="./storage"
S3_BUCKET=""
S3_REGION="tor1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
NEXT_PUBLIC_MEDIA_URL=""
